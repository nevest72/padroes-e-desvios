---
import { render } from 'astro:content';
import Base from '../../layouts/Base.astro';
import { getOpinion, emOutlet } from '../../lib/opiniao.js';
import { fmtDateLong, isoDate, joinNames } from '../../lib/format.js';

// Têm página aqui os textos com o texto completo no site (incluindo os que saíram primeiro num jornal).
export async function getStaticPaths() {
  const all = await getOpinion();
  return all.filter(o => o.native).map(o => ({ params: { slug: o.id }, props: { item: o } }));
}
const { item } = Astro.props;
const { Content } = await render(item.entry);
---
<Base lang="pt" title={item.title} description={item.summary || item.title} altHref={item.enHref || '/en/'}>
  <Fragment slot="head">
    {item.date && <meta property="article:published_time" content={isoDate(item.date)}>}
    {item.enHref && <link rel="alternate" hreflang="en" href={new URL(item.enHref, Astro.site)}>}
  </Fragment>
  <article class="article">
    <div class="wrap">
      <header class="article-head">
        <p class="article-back"><a href="/#opiniao">← Opinião</a></p>
        <p class="meta"><span class="outlet">Padrões e Desvios</span>{item.date && <time datetime={isoDate(item.date)}>{fmtDateLong(item.date)}</time>}</p>
        <h1>{item.title}</h1>
        {item.summary && <p class="article-sum">{item.summary}</p>}
        <p class="op-by" set:html={'Por ' + joinNames(item.authors, ' e ')} />
        {item.original && (
          <p class="article-orig">
            Publicado originalmente {emOutlet(item.original.outlet)}{item.date && <>, a {fmtDateLong(item.date)}</>}.
            {item.original.url && <> <a href={item.original.url}>Ler {emOutlet(item.original.outlet)}</a>.</>}
          </p>
        )}
        {item.enHref && <p class="article-orig"><a href={item.enHref} hreflang="en" lang="en">Read in English</a></p>}
      </header>
      <div class="prose">
        <Content />
      </div>
      <footer class="article-foot">
        <p>Os textos de opinião vinculam apenas quem os assina. <a href="/#opiniao">Mais textos de opinião</a>.</p>
      </footer>
    </div>
  </article>
</Base>
